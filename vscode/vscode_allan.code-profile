{
    "name": "vscode_allan_profile",
    "settings": "{\"settings\":\"{\\n    \\\"workbench.colorTheme\\\": \\\"Default Dark+\\\",\\n    \\\"workbench.colorCustomizations\\\": {\\n        \\\"focusBorder\\\": \\\"#ff00ff\\\",\\n\\n        \\\"list.activeSelectionBackground\\\": \\\"#ff00ff42\\\",\\n        \\n        \\\"editor.selectionBackground\\\": \\\"#ff00ff42\\\",\\n        \\\"editor.findMatchBackground\\\": \\\"#ff00ffaa\\\",\\n        \\\"editor.findMatchHighlightBackground\\\": \\\"#ff00ff72\\\",\\n\\n        \\\"statusBar.background\\\": \\\"#333333\\\",\\n        \\\"tab.activeBackground\\\": \\\"#423342\\\",\\n        \\\"tab.activeBorderTop\\\": \\\"#ff00ff\\\",\\n        \\\"activityBarBadge.background\\\": \\\"#ff00ff\\\",\\n    },\\n    \\\"editor.fontSize\\\": 20,\\n    \\n    \\\"terminal.integrated.shellIntegration.enabled\\\": true,\\n    \\\"explorer.confirmDragAndDrop\\\": false,\\n    \\\"editor.stickyScroll.enabled\\\": false,\\n    \\\"github.copilot.advanced\\\": {},\\n    \\n    \\\"files.associations\\\": {\\n        \\\"*.arb\\\": \\\"json\\\"\\n    },\\n\\n    \\\"theme-by-language.themes\\\": {\\n        \\\"*\\\": \\\"Default Dark+\\\",\\n        \\\"elixir\\\": \\\"Darcula theme for Elixir\\\"\\n    },\\n    \\n    \\\"[elixir]\\\": {\\n        \\\"editor.acceptSuggestionOnEnter\\\": \\\"on\\\",\\n        \\\"editor.insertSpaces\\\": true,\\n        \\\"editor.formatOnType\\\": true,\\n        \\\"editor.tabSize\\\": 2,\\n        \\\"editor.trimAutoWhitespace\\\": false,\\n        \\\"editor.wordBasedSuggestions\\\": \\\"off\\\",\\n        \\n        \\\"files.trimTrailingWhitespace\\\": true,\\n        \\\"files.insertFinalNewline\\\": true,\\n        \\\"editor.defaultFormatter\\\": \\\"saratravi.elixir-formatter\\\",\\n    },\\n    \\\"elixirLS.dialyzerEnabled\\\": true,\\n    \\\"elixirLS.dialyzerFormat\\\": \\\"dialyzer\\\",\\n    \\\"elixirLS.fetchDeps\\\": true,\\n    \\\"elixirLS.suggestSpecs\\\": true,\\n\\n    \\\"[python]\\\": {\\n        \\\"editor.formatOnType\\\": true\\n    },\\n    \\\"python.analysis.autoImportCompletions\\\": true,\\n\\n    \\\"[clojure]\\\": {\\n    },\\n    \\\"calva.highlight.rainbowIndentGuides\\\": true,\\n    \\\"calva.paredit.defaultKeyMap\\\": \\\"strict\\\",\\n\\n    \\\"[dart]\\\": {\\n        \\\"editor.formatOnSave\\\": true,\\n        \\\"editor.formatOnType\\\": true,\\n        // \\\"editor.rulers\\\": [\\n        //     120\\n        // ],\\n        \\\"editor.selectionHighlight\\\": false,\\n        \\\"editor.suggest.snippetsPreventQuickSuggestions\\\": false,\\n        \\\"editor.suggestSelection\\\": \\\"first\\\",\\n        \\\"editor.tabCompletion\\\": \\\"onlySnippets\\\",\\n        \\\"editor.wordBasedSuggestions\\\": \\\"off\\\"\\n    },\\n    \\\"dart.openDevTools\\\": \\\"flutter\\\",\\n    \\\"window.zoomLevel\\\": -1,\\n\\n    \\\"[ruby]\\\": {\\n        \\\"editor.tabSize\\\": 2,\\n        \\\"editor.insertSpaces\\\": true,\\n        \\\"files.trimTrailingWhitespace\\\": true,\\n        \\\"editor.defaultFormatter\\\": \\\"Shopify.ruby-lsp\\\",\\n        \\\"editor.formatOnSave\\\": true,\\n        \\\"editor.formatOnType\\\": true,\\n        \\\"files.insertFinalNewline\\\": true,\\n        \\\"files.trimFinalNewlines\\\": true,\\n        \\\"editor.rulers\\\": [\\n            120\\n        ],\\n        \\\"editor.semanticHighlighting.enabled\\\": true\\n    },\\n    \\\"rubyLsp.rubyVersionManager\\\": {\\n        \\\"identifier\\\": \\\"asdf\\\"\\n    },\\n    \\\"rubyLsp.formatter\\\": \\\"auto\\\",\\n    \\\"github.copilot.editor.enableAutoCompletions\\\": true,\\n    \\\"update.mode\\\": \\\"manual\\\",\\n}\"}",
    "keybindings": "{\"keybindings\":\"// Place your key bindings in this file to override the defaultsauto[]\\n[\\n    {\\n        \\\"key\\\": \\\"ctrl+[Quote]\\\",\\n        \\\"command\\\": \\\"workbench.action.terminal.toggleTerminal\\\",\\n        \\\"when\\\": \\\"terminal.active\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+`\\\",\\n        \\\"command\\\": \\\"-workbench.action.terminal.toggleTerminal\\\",\\n        \\\"when\\\": \\\"terminal.active\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+l\\\",\\n        \\\"command\\\": \\\"calva.jackIn\\\",\\n        \\\"when\\\": \\\"calva:keybindingsEnabled && workspaceFolderCount > 0\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+c ctrl+alt+j\\\",\\n        \\\"command\\\": \\\"-calva.jackIn\\\",\\n        \\\"when\\\": \\\"calva:keybindingsEnabled && workspaceFolderCount > 0\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+f\\\",\\n        \\\"command\\\": \\\"calva-fmt.alignCurrentForm\\\",\\n        \\\"when\\\": \\\"calva:keybindingsEnabled && editorTextFocus && !editorReadOnly && !hasOtherSuggestions && !suggestWidgetVisible && editorLangId == 'clojure'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+l\\\",\\n        \\\"command\\\": \\\"-calva-fmt.alignCurrentForm\\\",\\n        \\\"when\\\": \\\"calva:keybindingsEnabled && editorTextFocus && !editorReadOnly && !hasOtherSuggestions && !suggestWidgetVisible && editorLangId == 'clojure'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+shift+l\\\",\\n        \\\"command\\\": \\\"calva.loadFile\\\",\\n        \\\"when\\\": \\\"calva:connected && calva:keybindingsEnabled && editorLangId == 'clojure'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+c enter\\\",\\n        \\\"command\\\": \\\"-calva.loadFile\\\",\\n        \\\"when\\\": \\\"calva:connected && calva:keybindingsEnabled && editorLangId == 'clojure'\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+alt+=\\\",\\n        \\\"command\\\": \\\"editor.action.revealDefinition\\\",\\n        \\\"when\\\": \\\"editorHasDefinitionProvider && editorTextFocus && !isInEmbeddedEditor\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"alt+/\\\",\\n        \\\"command\\\": \\\"github.copilot.acceptCursorPanelSolution\\\",\\n        \\\"when\\\": \\\"github.copilot.activated && github.copilot.panelVisible\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+/\\\",\\n        \\\"command\\\": \\\"-github.copilot.acceptCursorPanelSolution\\\",\\n        \\\"when\\\": \\\"github.copilot.activated && github.copilot.panelVisible\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+shift+i\\\",\\n        \\\"command\\\": \\\"workbench.panel.chat.view.copilot.focus\\\"\\n    }\\n]\",\"platform\":2}",
